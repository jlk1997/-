# =============================================================================
# 比特音 — 环境变量模板
#
# 怎么用
#   1. 复制成正式文件：Copy-Item .env.example .env
#   2. 按下面大白话改 .env（真密钥只写在 .env 里，不要提交到 Git）
#   3. 网页/小程序另外复制：Copy-Item apps\client\.env.example apps\client\.env
#
# 这个文件给 backend / Celery 看。改完要重启后端。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 总开关
# -----------------------------------------------------------------------------
APP_NAME=比特音
APP_VERSION=3.0.0
API_PREFIX=/api/v1
PIPELINE_VERSION=vibe-sorcery/3.0.0

# 本机调试填 true。对外上线必须 false（假歌、假充值、假合作接口都会被禁止）。
DEBUG=true
# 没 AI 密钥时假装出歌。本机可 true；对外必须 false。
DEV_MOCK_GENERATION=true
# 启动时自动改数据库表。本机建议 true。
RUN_ALEMBIC_ON_STARTUP=true


# -----------------------------------------------------------------------------
# 2. 出歌 AI
# -----------------------------------------------------------------------------
# 主路 MiniMax。国内控制台：https://platform.minimaxi.com
MINIMAX_API_KEY=
# 国内：https://api.minimaxi.com/v1    国际：https://api.minimax.io/v1
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_MUSIC_MODEL=music-2.6
MINIMAX_MUSIC_COVER_MODEL=music-cover
MINIMAX_CHAT_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01
# 流式只能 hex。一直「准备失败」就改 MINIMAX_MUSIC_STREAM=false
MINIMAX_MUSIC_OUTPUT_FORMAT=hex
MINIMAX_MUSIC_STREAM=true
MINIMAX_MUSIC_SAMPLE_RATE=44100
MINIMAX_MUSIC_BITRATE=256000
MINIMAX_MUSIC_FORMAT=mp3
MINIMAX_LYRICS_OPTIMIZER_DEFAULT=false
MINIMAX_COVER_MODE_DEFAULT=one_step
MINIMAX_MUSIC_TIMEOUT_SECONDS=600
MINIMAX_CHAT_TIMEOUT_SECONDS=120
MINIMAX_HTTP_RETRIES=3
MINIMAX_HTTP_TRUST_ENV=false
MINIMAX_MAX_INFLIGHT=2
MINIMAX_HTTP_MAX_CONNECTIONS=16
MINIMAX_HTTP_MAX_KEEPALIVE=8
# 腾讯云 TokenHub MiniMax music v3.0。有这把钥匙时，出歌优先走它；翻唱、写词、对话、图片仍走上面的 MiniMax。
TOKENHUB_API_KEY=
TOKENHUB_API_BASE=https://tokenhub.tencentmaas.com
TOKENHUB_MUSIC_MODEL=minimax-music-v3.0
TOKENHUB_MUSIC_OUTPUT_FORMAT=url
TOKENHUB_MUSIC_TIMEOUT_SECONDS=600
TOKENHUB_MAX_INFLIGHT=4
TOKENHUB_AIGC_WATERMARK=false
MUSIC_COVER_ENABLED=true

# 备路。没有就留空。不要填来路不明的套壳。
MUREKA_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
FUN_MUSIC_ENABLED=false


# -----------------------------------------------------------------------------
# 3. 数据库和排队
# -----------------------------------------------------------------------------
# 本机 Docker 常见 5433。端口被占就改成映射后的端口（本仓库有人用 5434）。
DATABASE_URL=postgresql://vibe:vibe@localhost:5433/vibe_sorcery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# 本机一个工人用 solo。对外多核再改 prefork。
CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=1
CELERY_POST_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1740
VARIATION_PARALLEL=true
QUEUE_MAX_DEPTH=200
STALE_PENDING_MINUTES=15
DEFAULT_COMPOSE_ETA_SECONDS=90
COMPOSE_STATS_WINDOW=50


# -----------------------------------------------------------------------------
# 4. 登录
# -----------------------------------------------------------------------------
# 对外必须换成一长串随机字（至少 32 个）：openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
# 7 天
JWT_EXPIRE_MINUTES=10080
# 还没有管理员时，把这个邮箱提成管理员。对外提完建议留空。
ADMIN_BOOTSTRAP_EMAIL=


# -----------------------------------------------------------------------------
# 5. 文件存储
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vibe-sorcery
S3_REGION=us-east-1
S3_USE_SSL=false
CDN_BASE_URL=
FFMPEG_PATH=ffmpeg
STEM_SEPARATOR=auto
# Preview exports may fall back to ffmpeg bands. Review / originality packs require Demucs.
# Optional worker image: docker build --build-arg INSTALL_DEMUCS=true (see backend/requirements-stems.txt).
MODELS_DIR=
C2PA_ENABLED=true
BLOCKCHAIN_ANCHOR_ENABLED=false
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT=
MEDIA_PLAYBACK_TICKET_TTL_SECONDS=600
MEDIA_HLS_SEGMENT_PRESIGN_SECONDS=600
WS_STREAM_TICKET_TTL_SECONDS=120


# -----------------------------------------------------------------------------
# 6. 给外人看的网址
# -----------------------------------------------------------------------------
# 创作者连接器配对也用这个。对外必须是公网 API，不能是 localhost。
API_PUBLIC_URL=http://localhost:8000/api/v1
# 网页地址。本机 H5 是 10086。生产用 https://superformersmusic.com。
FRONTEND_BASE_URL=http://localhost:10086
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:10086,http://127.0.0.1:10086,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081,https://superformersmusic.com,https://www.superformersmusic.com,http://superformersmusic.com,http://www.superformersmusic.com,http://139.199.90.218


# -----------------------------------------------------------------------------
# 7. 额度
# -----------------------------------------------------------------------------
# 没点不能出歌。运维排查才能关。
CREDITS_GATE_ENABLED=true
WELCOME_CREDITS=15
DAILY_CHECKIN_CREDITS=1
TASK_CREDITS_FIRST_PUBLISH=3
TASK_CREDITS_JOURNEY_FEEDBACK=2
TASK_CREDITS_FIRST_REMIX=1
TASK_CREDITS_FIRST_CHALLENGE=2
REFERRAL_ENABLED=true
REFERRAL_CREDITS_REFERRER=5
REFERRAL_CREDITS_INVITEE=5
SUBSCRIPTION_MONTHLY_CREDITS=30
PAYMENT_ORDER_TTL_HOURS=2


# -----------------------------------------------------------------------------
# 8. 收钱（不用的渠道留空）
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_SUBSCRIPTION_YEARLY_PRICE_ID=

# 微信：AppID + AppSecret + 商户号 + APIv2 的 32 位密钥（不要填 APIv3）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_TPL_JOB_COMPLETE=
WECHAT_TPL_LOW_CREDITS=
WECHAT_OFFER_ID=
WECHAT_VPAY_APPKEY_PROD=
WECHAT_VPAY_APPKEY_SANDBOX=
# 1 沙箱联调；上线改 0
WECHAT_VPAY_ENV=1
WECHAT_PUSH_TOKEN=
WECHAT_VPAY_GOODS_JSON=

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true


# -----------------------------------------------------------------------------
# 9. 发行 / 连接器 / 农场
# -----------------------------------------------------------------------------
PLATFORM_SEAT_POOL_SIZE=1
VIBE_PLATFORM_POOL_SIZE=1
ASSIST_JOB_TTL_MINUTES=45
# 本机测试填 0。先重建 browser-farm（INSTALL_PLAYWRIGHT=true）再设 1。
# 没装 Playwright 时 farm_can_navigate() 仍为 false。
INSTALL_PLAYWRIGHT=false
VIBE_FARM_NAVIGATE=0
# 对外必须 false
PARTNER_STUB_ENABLED=false
PARTNER_WEBHOOK_SECRET=
DISTROKID_API_KEY=
DISTROKID_API_BASE=
TUNECORE_API_KEY=
TUNECORE_API_BASE=
ROUTENOTE_API_KEY=
ROUTENOTE_API_BASE=
CN_LABEL_API_KEY=
CN_LABEL_API_BASE=
CHARTMETRIC_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=


# -----------------------------------------------------------------------------
# 10. 客服和法律
# -----------------------------------------------------------------------------
LEGAL_COMPANY_NAME=比特音
LEGAL_ICP_NUMBER=
# 下面两个是占位。DEBUG=false 时必须换成真实客服，否则后端起不来。
LEGAL_CONTACT_EMAIL=privacy@vibe-sorcery.com
LEGAL_CONTACT_PHONE=400-000-0000


# -----------------------------------------------------------------------------
# 11. 其它
# -----------------------------------------------------------------------------
DEFAULT_TENANT_ID=default
MULTI_TENANT_ENABLED=false
COPILOT_LLM_STREAM=true
COPILOT_RATE_LIMIT_PER_MINUTE=30
# 对外建议 true：Redis 挂了宁可不生成。
RATE_LIMIT_FAIL_CLOSED=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
METRICS_ENABLED=true
METRICS_TOKEN=

# 运营告警 webhook（飞书/Slack/企微等）
OPS_ALERT_WEBHOOK_URL=

# 邮件通知
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_API_URL=
EMAIL_API_KEY=

# 微信订阅消息
WECHAT_SUBSCRIBE_TEMPLATE_LOW_CREDITS=

# 内容审核 / ASR
AUDIO_MODERATION_API_URL=
AUDIO_MODERATION_API_KEY=
ASR_API_URL=
ASR_API_KEY=

# KYC 实名。没配厂商时申请只进人工队列，不会假装已通过。
KYC_API_URL=
KYC_API_KEY=
KYC_PROVIDER=
KYC_WEBHOOK_SECRET=

# 席位保险柜。空则用 JWT_SECRET 派生 Fernet；旧 XOR 密文仍能解密。
SEAT_VAULT_KEY=

# 生产 HTTPS（证书已装到 /opt/bittune/certs/ 后）：
# FRONTEND_BASE_URL=https://superformersmusic.com
# API_PUBLIC_URL=https://superformersmusic.com/api/v1
# 证书未到时先用 http://superformersmusic.com，不要 301。

# 全球合规
STRIPE_TAX_ENABLED=false
FX_API_URL=
FX_API_KEY=
DEFAULT_PAYOUT_CURRENCY=CNY
FINGERPRINT_API_URL=
FINGERPRINT_API_KEY=

# Docker 构建 pip 太慢时取消下一行注释
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple


# =============================================================================
# 网页/小程序：apps/client/.env
#   TARO_APP_API_URL=http://localhost:8000/api/v1
#   小程序真机不要填 localhost，填局域网 IP 或 HTTPS 域名
# =============================================================================
